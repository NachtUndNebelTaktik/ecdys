{
  "name": "styg",
  "version": "0.3.0",
  "private": true,
  "description": "Styg desktop session and profile manager \u2014 independent branches and recovery previews",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "preview": "vite --config vite.preview.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "native:node": "npm rebuild better-sqlite3-multiple-ciphers",
    "native:electron": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "routing:preflight": "node scripts/routing-preflight.mjs",
    "electron:install": "install-electron",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "solid-js": "^1.9.9",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
